# ─── Web3Auth ────────────────────────────────────────────────────────────────
# Obtén tu Client ID en https://dashboard.web3auth.io (red Sapphire Devnet)
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID="BXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# "sapphire_devnet" para pruebas | "sapphire_mainnet" en producción
NEXT_PUBLIC_WEB3AUTH_NETWORK="sapphire_devnet"

# ─── Avalanche Fuji Testnet (Chain ID 43113) ────────────────────────────────
NEXT_PUBLIC_CHAIN_ID="43113"
NEXT_PUBLIC_RPC_URL="https://api.avax-test.network/ext/bc/C/rpc"
NEXT_PUBLIC_EXPLORER_URL="https://testnet.snowtrace.io"

# ─── Contratos desplegados en Fuji ──────────────────────────────────────────
# Token ERC-20 de Gobernanza (con snapshot / ERC20Votes)
NEXT_PUBLIC_GOV_TOKEN_ADDRESS="0x0000000000000000000000000000000000000000"
# Contrato de votación / Governor
NEXT_PUBLIC_GOVERNOR_ADDRESS="0x0000000000000000000000000000000000000000"

# ─── Jitsi Meet ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_JITSI_DOMAIN="meet.jit.si"

# ─── Asistente IA (orquestador n8n) ─────────────────────────────────────────
